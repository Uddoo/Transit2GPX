TRANSIT2GPX_ENVIRONMENT=development
TRANSIT2GPX_HOST=127.0.0.1
TRANSIT2GPX_PORT=8765
# TRANSIT2GPX_DATA_DIR=/absolute/path/to/app-data
# TRANSIT2GPX_DATABASE_URL=sqlite:////absolute/path/to/transit2gpx.sqlite3
# Standard OSM tiles are for interactive viewing only; do not prefetch them.
TRANSIT2GPX_MAP_TILES_ENABLED=true
TRANSIT2GPX_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TRANSIT2GPX_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
TRANSIT2GPX_MAP_MAX_ZOOM=19
# Optional railway runtime. Build and activate a graph before enabling these.
# TRANSIT2GPX_RAIL_ENABLED=true
# TRANSIT2GPX_RAIL_GRAPH_VERSION=active
# TRANSIT2GPX_RAIL_GRAPH_ROOT=/absolute/path/to/rail-routing/graphs
# TRANSIT2GPX_RAIL_SIDECAR_URL=http://127.0.0.1:8989
# Let FastAPI supervise the identity-checked loopback sidecar.
# TRANSIT2GPX_RAIL_SIDECAR_MANAGED=true
# TRANSIT2GPX_RAIL_SIDECAR_JAR=/absolute/path/to/openrailrouting.jar
# TRANSIT2GPX_RAIL_PBF_PATH=/absolute/path/to/region.osm.pbf
# TRANSIT2GPX_RAIL_JAVA_HOME=/absolute/path/to/jdk-21

# Legacy METRO2FOG_* names remain accepted for existing installations.
