METRO2FOG_ENVIRONMENT=development
METRO2FOG_HOST=127.0.0.1
METRO2FOG_PORT=8765
# METRO2FOG_DATA_DIR=/absolute/path/to/app-data
# METRO2FOG_DATABASE_URL=sqlite:////absolute/path/to/metro2fog.sqlite3
# Standard OSM tiles are for interactive viewing only; do not prefetch them.
METRO2FOG_MAP_TILES_ENABLED=true
METRO2FOG_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
METRO2FOG_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
METRO2FOG_MAP_MAX_ZOOM=19
