{
  "name": "transit2fog-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . --max-warnings 0",
    "api:export": "uv run --project ../backend python ../scripts/export_openapi.py openapi.json",
    "api:generate": "npm run api:export && openapi-typescript openapi.json --output src/api/generated.ts --alphabetize --empty-objects-unknown",
    "api:check": "uv run --project ../backend python ../scripts/export_openapi.py openapi.json --check && openapi-typescript openapi.json --output src/api/generated.ts --check --alphabetize --empty-objects-unknown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "node scripts/run-fullstack-e2e.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
