+package de.geofabrik.railway_routing.http;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.core.MediaType;
+
+@Path("/metro2fog/metadata")
+@Produces(MediaType.APPLICATION_JSON)
+public final class Metro2FogMetadataResource {
+    @GET
+    public Map<String, String> metadata() {
+        Map<String, String> values = new LinkedHashMap<>();
+        values.put("graph_version", property("metro2fog.graph.version"));
+        values.put("pbf_sha256", property("metro2fog.pbf.sha256"));
+        values.put("profile_version", property("metro2fog.profile.version"));
+        values.put("openrailrouting_commit", property("metro2fog.openrailrouting.commit"));
+        return values;
+    }
+
+    private static String property(String name) {
+        String value = System.getProperty(name, "").trim();
+        if (value.isEmpty()) {
+            throw new IllegalStateException("Missing required sidecar identity property: " + name);
+        }
+        return value;
+    }
+}
