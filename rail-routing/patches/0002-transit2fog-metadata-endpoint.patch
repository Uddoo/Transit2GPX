+package de.geofabrik.railway_routing.http;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.core.MediaType;
+
+@Path("/transit2fog/metadata")
+@Produces(MediaType.APPLICATION_JSON)
+public final class Transit2FogMetadataResource {
+    @GET
+    public Map<String, String> metadata() {
+        Map<String, String> values = new LinkedHashMap<>();
+        values.put("graph_version", property("graph.version"));
+        values.put("pbf_sha256", property("pbf.sha256"));
+        values.put("profile_version", property("profile.version"));
+        values.put("openrailrouting_commit", property("openrailrouting.commit"));
+        return values;
+    }
+
+    private static String property(String suffix) {
+        String currentName = "transit2fog." + suffix;
+        String value = System.getProperty(currentName, "").trim();
+        if (value.isEmpty()) {
+            value = System.getProperty("metro2fog." + suffix, "").trim();
+        }
+        if (value.isEmpty()) {
+            throw new IllegalStateException("Missing required sidecar identity property: " + currentName);
+        }
+        return value;
+    }
+}
