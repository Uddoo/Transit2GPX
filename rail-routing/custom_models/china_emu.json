{
  "distance_influence": 0,
  "priority": [
    { "if": "railway_service == YARD || railway_service == SPUR", "multiply_by": "0" },
    { "else_if": "railway_service == SIDING || railway_service == CROSSOVER", "multiply_by": "0.2" },
    { "else_if": "electrified == NO || electrified == RAIL", "multiply_by": "0.2" },
    { "else_if": "rail_average_speed < 80", "multiply_by": "0.5" }
  ],
  "speed": [
    { "if": "true", "limit_to": "250" }
  ]
}
